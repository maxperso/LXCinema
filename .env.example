# Copy to .env and fill in. .env is gitignored and must stay that way.
#   cp .env.example .env

# ProtonVPN over WireGuard, through Gluetun.
# The private key comes from your Proton account (Downloads > WireGuard
# configuration). Anyone holding it can use your VPN subscription.
WIREGUARD_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=

# The Address line from the same WireGuard config file.
WIREGUARD_ADDRESSES=10.2.0.2/32

# Exit country. Pick one where Proton supports port forwarding, otherwise
# port-sync has nothing to sync.
PROTONVPN_COUNTRY=Netherlands

# Host path holding torrents/, movies/ and tv/. It must exist and be owned
# by PUID:PGID below.
DATA_ROOT=/data

# Numeric owner of the media files and service configs. The numbers are what
# matter: on this install GID 1000 has no name inside the LXC and everything
# works. Seerr ignores this and always runs as UID 1000.
# PGID is also the group to give the GPU render node in the LXC config
# (dev0: /dev/dri/renderD128,gid=<PGID>), see docs/lxc-proxmox.md.
PUID=1000
PGID=1000

TZ=Europe/Paris
